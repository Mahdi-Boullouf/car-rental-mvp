generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN // platform owner — provisions agencies, no agencyId
  OWNER // agency owner
  AGENT // agency staff
}

/// A tenant: one showroom/agency. All data is scoped to it.
model Agency {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique // public URL: /<slug>
  phone          String?
  city           String?
  active         Boolean  @default(true)
  rentalsEnabled Boolean  @default(true) // module: fleet + bookings + contracts
  salesEnabled   Boolean  @default(true) // module: sales showroom
  createdAt      DateTime @default(now())

  users    User[]
  cars     Car[]
  bookings Booking[]
  sales    SaleListing[]
  settings StoreSettings?
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(OWNER)
  agency    Agency?  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId  String? // null for SUPER_ADMIN
  createdAt DateTime @default(now())
}

/// Rental fleet (scoped to an agency).
model Car {
  id           String    @id @default(uuid())
  agency       Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId     String
  name         String
  bodyType     String
  year         Int
  fuel         String
  transmission String
  seats        Int
  pricePerDay  Int
  image        String
  createdAt    DateTime  @default(now())
  bookings     Booking[]

  @@index([agencyId])
}

model Booking {
  id        String   @id @default(uuid())
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId  String
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  carId     String
  customer  String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())

  @@index([agencyId, carId, startDate, endDate])
}

/// A car listed for sale in the agency's public storefront.
model SaleListing {
  id          String   @id @default(uuid())
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId    String
  title       String
  brand       String?
  model       String?
  year        Int?
  price       Int
  km          Int?
  fuel        String?
  gearbox     String?
  color       String?
  phone       String?
  wilaya      String?
  description String?
  images      String[]
  sold        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([agencyId])
}

/// Public showroom branding — one row per agency.
model StoreSettings {
  id        String   @id @default(uuid())
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId  String   @unique
  logo      String?
  cover     String?
  updatedAt DateTime @updatedAt
}
