# SPA routing: serve index.html for any path that isn't a real file/folder,
# so /:slug, /:slug/car/:id and /admin/* work on Apache (cPanel).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
